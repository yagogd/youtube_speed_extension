{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "es",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://video.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["src/ui/transcript.css"],
      "js": [
        "src/utils/i18n.js",
        "src/transcript/transcript-parser.js",
        "src/content/namespace.js",
        "src/utils/time.js",
        "src/ui/panel-drag.js",
        "src/ui/panel-resize.js",
        "src/transcript/transcript-search.js",
        "src/notes/video-notes.js",
        "src/ui/track-selector.js",
        "src/ui/panel-view.js",
        "src/ui/transcript-panel.js",
        "src/ui/player/note-markers.js",
        "src/ui/player/note-editor.js",
        "src/ui/player/speed-menu.js",
        "src/ui/player/controls.js",
        "src/transcript/transcript-sync.js",
        "src/transcript/transcript-renderer.js",
        "src/content/message-bridge.js",
        "src/content/youtube-navigation.js",
        "src/content/transcript-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/playback-controller.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected/transcript-network.js", "src/transcript/transcript-parser.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}
