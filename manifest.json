{
  "manifest_version": 3,
  "name": "YouTube Speed Setter + Transcript",
  "version": "1.0",
  "description": "Controla la velocidad y muestra subtítulos de YouTube",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://video.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["src/ui/transcript.css"],
      "js": [
        "src/utils/transcript-parser.js",
        "src/content/namespace.js",
        "src/utils/time.js",
        "src/ui/panel-drag.js",
        "src/ui/panel-resize.js",
        "src/transcript/transcript-search.js",
        "src/notes/video-notes.js",
        "src/ui/transcript-panel.js",
        "src/ui/player-controls.js",
        "src/transcript/transcript-sync.js",
        "src/transcript/transcript-renderer.js",
        "src/content/message-bridge.js",
        "src/content/youtube-navigation.js",
        "src/content/transcript-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "src/utils/transcript-parser.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
